{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "target": "ES2022", // Más moderno que esnext
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "skipLibCheck": true, // Mejora performance
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true, // Más estricto
    "noUncheckedIndexedAccess": true // Más seguro
  },
  "include": ["src/**/*", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
